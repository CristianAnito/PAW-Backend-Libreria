<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    # Front controller: toda petición que no sea un archivo real de public/ va a index.php.
    # (No se redirige "/ruta/" a "/ruta": Request ya ignora la barra final, y una redirección
    # detrás del proxy de Render armaría la URL con http y el puerto interno.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
