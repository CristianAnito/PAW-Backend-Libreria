# Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# development: muestra el detalle de los errores. production: mensaje genérico.
APP_ENV=development
APP_URL=http://localhost:8000
LOG_LEVEL=debug

# smtp: envía el mail de verdad. log: lo escribe en storage/logs/app.log (para desarrollo).
MAIL_DRIVER=log

# Destinatario de las reservas (personal de la librería)
MAIL_TO=admin@libreria.com
MAIL_FROM=no-reply@libreria.com
MAIL_FROM_NAME=PAWPrints

# Servidor SMTP (ej. Mailtrap para pruebas)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=null
MAIL_PASS=null
MAIL_ENCRYPTION=tls
