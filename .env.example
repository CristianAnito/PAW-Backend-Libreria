# Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# development: muestra el detalle de los errores. production: mensaje genérico.
APP_ENV=development
APP_URL=http://localhost:8000
LOG_LEVEL=debug

# Orígenes del frontend (SPA) autorizados a llamar a la API, separados por coma (CORS).
# Deben coincidir exactamente con la URL desde la que se abre el frontend.
CORS_ORIGINS=http://localhost:5501,http://127.0.0.1:5501

# Autenticación (JWT en cookie HttpOnly).
# JWT_SECRET: clave para firmar los tokens. Mínimo 32 caracteres, aleatoria y distinta en cada entorno.
# Generarla con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Duración de la sesión en segundos (3600 = 1 hora).
JWT_TTL=3600

# Envío del mail de cada compra al personal de la librería.
# log:   no envía; lo escribe en storage/logs/app.log (desarrollo).
# brevo: lo envía con la API HTTP de Brevo (producción; Render gratis bloquea SMTP).
# smtp:  lo envía por SMTP con PHPMailer (pruebas locales).
MAIL_DRIVER=log

# Destinatario: el personal de la librería.
MAIL_TO=admin@libreria.com
# Remitente: con brevo, tiene que ser un remitente verificado en la cuenta (Senders).
MAIL_FROM=no-reply@libreria.com
MAIL_FROM_NAME=PAWPrints

# Solo para MAIL_DRIVER=brevo: Brevo > SMTP & API > API Keys. Es secreta: nunca al repositorio.
BREVO_API_KEY=

# Solo para MAIL_DRIVER=smtp (ej. Mailtrap para pruebas)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=null
MAIL_PASS=null
MAIL_ENCRYPTION=tls
