# Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# development: muestra el detalle de los errores. production: mensaje genérico.
APP_ENV=development
APP_URL=http://localhost:8000
LOG_LEVEL=debug

# Orígenes del frontend (SPA) autorizados a llamar a la API, separados por coma (CORS).
# Deben coincidir exactamente con la URL desde la que se abre el frontend.
CORS_ORIGINS=http://localhost:5501,http://127.0.0.1:5501

# Autenticación (JWT en cookie HttpOnly).
# JWT_SECRET: clave para firmar los tokens. Mínimo 32 caracteres, aleatoria y distinta en cada entorno.
# Generarla con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Duración de la sesión en segundos (3600 = 1 hora).
JWT_TTL=3600

# smtp: envía el mail de verdad. log: lo escribe en storage/logs/app.log (para desarrollo).
MAIL_DRIVER=log

# Destinatario de las reservas (personal de la librería)
MAIL_TO=admin@libreria.com
MAIL_FROM=no-reply@libreria.com
MAIL_FROM_NAME=PAWPrints

# Servidor SMTP (ej. Mailtrap para pruebas)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=null
MAIL_PASS=null
MAIL_ENCRYPTION=tls
